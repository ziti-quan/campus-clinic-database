# 复制本文件为 .env，填入你自己的数据库信息后再启动应用。
# .env 已在 .gitignore 中，不会被提交到仓库，请勿把真实口令写进源码或 .env.example。

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3308
DB_NAME=hospital
DB_USER=root
DB_PASSWORD=your_mysql_password

# 也可以直接给出完整连接串（优先级高于上面的分项配置）
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3308/hospital

# ---------- Flask 会话密钥 ----------
# 生成方式： python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please_replace_with_a_random_string
DOCTOR_SECRET_KEY=please_replace_with_another_random_string
